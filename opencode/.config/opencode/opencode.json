            "name": "oMLX",
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "http://127.0.0.1:8000/v1",
                "apiKey": "abcd"
            },
            "models": {
                "Laguna-XS.2-4bit": {
                    "name": "Laguna-XS.2-4bit",
                    "capabilities": {
                        "input": [
