    "mcp": {
        "servers": {
            "xcodebuildmcp": {
                "type": "local",
                "command": [
                    "xcodebuildmcp",
                    "mcp"
                ]
            },
            "Xcode": {
                "type": "local",
                "command": [
                    "xcrun",
                    "mcpbridge"
                ]
            },
            "axiom": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "axiom-mcp"
                ]
            }
        }
    },
