{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    "default_agent": "plan",
    "small_model": "lmstudio/laguna-xs-2.1-nvfp4-mlx",
    "plugin": [
        "./plugins/osascript-notifications.js"
    ],
    "mcp": {
        "xcodebuildmcp": {
            "type": "local",
            "command": [
                "xcodebuildmcp",
                "mcp"
            ]
        },
        "Xcode": {
            "type": "local",
            "command": [
                "xcrun",
                "mcpbridge"
            ]
        },
        "axiom": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "axiom-mcp"
            ]
        }
    },
    "permission": {
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "read": "allow",
        "bash": {
            "awk *": "allow",
            "brew list *": "allow",
            "bun *": "allow",
            "cat *": "allow",
            "cd *": "allow",
            "cp *": "allow",
            "echo *": "allow",
            "find *": "allow",
            "gh issue view *": "allow",
            "gh pr diff *": "allow",
            "gh pr checks *": "allow",
            "gh pr view *": "allow",
            "git *": "allow",
            "grep *": "allow",
            "head *": "allow",
            "herdr *": "allow",
            "jq *": "allow",
            "ls *": "allow",
            "mkdir *": "allow",
            "mv *": "allow",
            "node *": "allow",
            "npm *": "allow",
            "python3 *": "allow",
            "rg *": "allow",
            "sed *": "allow",
            "tail *": "allow",
            "touch *": "allow",
            "wc *": "allow",
            "which *": "allow",
            "xcbeautify": "allow",
            "xcodebuild *": "allow",
            "xcrun *": "allow",
            "swiftc *": "allow",
            "git push *": "ask",
            "npm install *": "ask",
            "rm *": "ask",
            "*": "ask"
        },
        "webfetch": "allow"
    },
    "provider": {
        "lmstudio": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "LM Studio (local)",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1"
            },
            "models": {
                "google/gemma-4-31b-qat": {
                    "name": "google/gemma-4-31b-qat"
                },
                "google/gemma-4-26b-a4b-qat": {
                    "name": "google/gemma-4-26b-a4b-qat"
                },
                "google/gemma-3-12b": {
                    "name": "google/gemma-3-12b"
                },
                "mistralai/devstral-small-2-2512": {
                    "name": "mistralai/devstral-small-2-2512"
                },
                "mistralai/ministral-3-14b-reasoning": {
                    "name": "mistralai/ministral-3-14b-reasoning"
                },
                "qwen/qwen3.6-35b-a3b": {
                    "name": "qwen/qwen3.6-35b-a3b"
                },
                "qwen3.8-27b": {
                    "name": "qwen3.8-27b"
                },
                "qwen/qwen2.5-coder-14b": {
                    "name": "qwen/qwen2.5-coder-14b"
                },
                "qwen/qwen3-14b": {
                    "name": "qwen/qwen3-14b"
                },
                "qwen/qwen3-8b": {
                    "name": "qwen/qwen3-8b"
                },
                "qwen/qwen3-4b": {
                    "name": "qwen/qwen3-4b"
                },
                "qwen/qwen3-vl-8b": {
                    "name": "qwen/qwen3-vl-8b"
                },
                "zai-org/glm-4.6v-flash": {
                    "name": "zai-org/glm-4.6v-flash"
                },
                "ternary-bonsai-27b-mlx": {
                    "name": "ternary-bonsai-27b-mlx"
                },
                "laguna-xs-2.1-nvfp4-mlx": {
                    "name": "laguna-xs-2.1-nvfp4-mlx"
                },
                "laguna-xs-2.1": {
                    "name": "laguna-xs-2.1"
                }
            }
        },
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama",
            "options": {
                "baseURL": "http://localhost:11434/v1"
            },
            "models": {
                "ministral-3:8b": {
                    "name": "ministral-3:8b"
                },
                "ministral-3:14b": {
                    "name": "ministral-3:14b"
                }
            }
        }
    }
}
